---
interface Props {
  title: string;
  description: string;
  url: string;
  image?: string;
  tags: string[];
}

const { title, description, url, image, tags } = Astro.props;
---

<div class="card overflow-hidden group">
  {image ? (
    <div class="relative overflow-hidden aspect-video">
      <img
        src={image}
        alt={`${title} project screenshot`}
        class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
      />
    </div>
  ) : (
    <div class="relative aspect-video bg-gradient-to-br from-gold/10 to-gold/5 dark:from-gold/20 dark:to-gold/5 flex items-center justify-center">
      <svg class="w-16 h-16 text-gold/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
      </svg>
    </div>
  )}
  <div class="p-6">
    <h2 class="text-xl font-heading font-semibold mb-2">{title}</h2>
    <p class="text-secondary text-sm leading-relaxed mb-4">{description}</p>
    <div class="flex flex-wrap gap-2 mb-4">
      {tags.map((tag) => (
        <span class="text-xs px-2 py-1 rounded-full bg-gold/10 text-gold dark:bg-gold/20 dark:text-gold font-medium">
          {tag}
        </span>
      ))}
    </div>
    <a
      href={url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-sm font-medium text-gold hover:underline"
    >
      View Site
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
  </div>
</div>
