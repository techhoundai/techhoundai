---
interface Props {
  title: string;
  description: string;
  url: string;
  image?: string;
  tags: string[];
}

const { title, description, url, image, tags } = Astro.props;
const hasImage = !!image;
---

{hasImage ? (
  <div class="card overflow-hidden group col-span-full hover:border-gold/30 transition-all duration-300">
    <div class="grid grid-cols-1 lg:grid-cols-2">
      <div class="relative overflow-hidden aspect-video lg:aspect-auto">
        <img
          src={image}
          alt={`${title} project screenshot`}
          class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-void/20 group-hover:bg-void/0 transition-colors"></div>
      </div>
      <div class="p-8 lg:p-10 flex flex-col justify-center">
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag) => (
            <span class="text-[10px] px-2 py-1 rounded-sm bg-gold/10 text-gold border border-gold/20 font-medium uppercase tracking-wider">
              {tag}
            </span>
          ))}
        </div>
        <h3 class="text-2xl sm:text-3xl font-heading font-bold mb-3 text-heading">{title}</h3>
        <p class="text-secondary leading-relaxed mb-6">{description}</p>
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-sm font-medium text-gold hover:text-gold-bright transition-colors"
        >
          Visit Site
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
) : (
  <div class="card overflow-hidden border-l-2 border-l-gold hover:border-gold/30 transition-all duration-300">
    <div class="p-8">
      <div class="flex flex-wrap gap-2 mb-4">
        {tags.map((tag) => (
          <span class="text-[10px] px-2 py-1 rounded-sm bg-gold/10 text-gold border border-gold/20 font-medium uppercase tracking-wider">
            {tag}
          </span>
        ))}
      </div>
      <h3 class="text-xl sm:text-2xl font-heading font-bold mb-3 text-heading">{title}</h3>
      <p class="text-secondary leading-relaxed mb-6">{description}</p>
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-medium text-gold hover:text-gold-bright transition-colors"
      >
        Visit Site
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
      </a>
    </div>
  </div>
)}
