---
import { siteConfig } from "../data/siteConfig";
---

<form id="contact-form" class="space-y-6">
  <input type="hidden" name="access_key" value={siteConfig.web3formsKey} />
  <input type="hidden" name="subject" value="New inquiry from techhound.ai" />
  <input type="checkbox" name="botcheck" class="hidden" />

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="name" class="block text-xs font-medium mb-2 uppercase tracking-wider text-[#555] dark:text-[#888]">Name *</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full px-4 py-3 rounded-sm border border-[#E0DCD0] dark:border-border-dark bg-white dark:bg-surface-darker text-[#1A1A1A] dark:text-[#E0DDD5] focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors placeholder-[#999] dark:placeholder-[#444]"
        placeholder="Your name"
      />
    </div>
    <div>
      <label for="email" class="block text-xs font-medium mb-2 uppercase tracking-wider text-[#555] dark:text-[#888]">Email *</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-3 rounded-sm border border-[#E0DCD0] dark:border-border-dark bg-white dark:bg-surface-darker text-[#1A1A1A] dark:text-[#E0DDD5] focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors placeholder-[#999] dark:placeholder-[#444]"
        placeholder="your@email.com"
      />
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <div>
      <label for="phone" class="block text-xs font-medium mb-2 uppercase tracking-wider text-[#555] dark:text-[#888]">Phone</label>
      <input
        type="tel"
        id="phone"
        name="phone"
        class="w-full px-4 py-3 rounded-sm border border-[#E0DCD0] dark:border-border-dark bg-white dark:bg-surface-darker text-[#1A1A1A] dark:text-[#E0DDD5] focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors placeholder-[#999] dark:placeholder-[#444]"
        placeholder="(412) 555-0123"
      />
    </div>
    <div>
      <label for="company" class="block text-xs font-medium mb-2 uppercase tracking-wider text-[#555] dark:text-[#888]">Company</label>
      <input
        type="text"
        id="company"
        name="company"
        class="w-full px-4 py-3 rounded-sm border border-[#E0DCD0] dark:border-border-dark bg-white dark:bg-surface-darker text-[#1A1A1A] dark:text-[#E0DDD5] focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors placeholder-[#999] dark:placeholder-[#444]"
        placeholder="Your business name"
      />
    </div>
  </div>

  <div>
    <label for="service" class="block text-xs font-medium mb-2 uppercase tracking-wider text-[#555] dark:text-[#888]">What can we help with?</label>
    <select
      id="service"
      name="service"
      class="w-full px-4 py-3 rounded-sm border border-[#E0DCD0] dark:border-border-dark bg-white dark:bg-surface-darker text-[#1A1A1A] dark:text-[#E0DDD5] focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors"
    >
      <option value="">Select a service</option>
      <option value="Full Package">The Full Package ($100/mo)</option>
      <option value="Contractor Website">Contractor Website</option>
      <option value="Google Reviews">Google Review Automation</option>
      <option value="Photo Sync">Job Photo Sync</option>
      <option value="Blog Posts">Automated Blog Posts</option>
      <option value="Lead Gen">Lead Gen & Backlinking</option>
      <option value="Missed Call Texts">Missed Call Auto-Texts</option>
      <option value="Platform Integrations">Platform Integrations</option>
      <option value="Custom">Custom Tech Solution</option>
      <option value="Other">Not sure yet</option>
    </select>
  </div>

  <div>
    <label for="message" class="block text-xs font-medium mb-2 uppercase tracking-wider text-[#555] dark:text-[#888]">Message *</label>
    <textarea
      id="message"
      name="message"
      required
      rows="5"
      class="w-full px-4 py-3 rounded-sm border border-[#E0DCD0] dark:border-border-dark bg-white dark:bg-surface-darker text-[#1A1A1A] dark:text-[#E0DDD5] focus:outline-none focus:ring-1 focus:ring-gold focus:border-gold transition-colors resize-vertical placeholder-[#999] dark:placeholder-[#444]"
      placeholder="Tell us about your business. What trade, where you're located, what you need help with..."
    ></textarea>
  </div>

  <button type="submit" class="btn-primary w-full sm:w-auto">
    Send Message
  </button>

  <div id="form-status" class="hidden"></div>
</form>

<script>
  function initContactForm() {
    const form = document.getElementById("contact-form") as HTMLFormElement;
    const status = document.getElementById("form-status");
    if (!form || !status) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      const originalText = submitBtn.textContent;
      submitBtn.textContent = "SENDING...";
      submitBtn.disabled = true;

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });

        const result = await response.json();

        if (result.success) {
          status.className = "p-4 rounded-sm bg-gold/10 border border-gold/30 text-gold text-sm";
          status.textContent = "Message received. We'll get back to you within 24 hours.";
          form.reset();
        } else {
          throw new Error(result.message || "Something went wrong");
        }
      } catch {
        status.className = "p-4 rounded-sm bg-red-900/20 border border-red-500/30 text-red-400 text-sm";
        status.textContent = "Something went wrong. Please try again or email us directly.";
      } finally {
        submitBtn.textContent = originalText;
        submitBtn.disabled = false;
      }
    });
  }

  initContactForm();
  document.addEventListener("astro:after-swap", initContactForm);
</script>
