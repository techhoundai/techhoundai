---
interface Props {
  quote: string;
  name: string;
  company: string;
}

const { quote, name, company } = Astro.props;
---

<blockquote class="card p-6 md:p-8 border-l-2 border-l-gold">
  <p class="text-lg leading-relaxed mb-4 italic text-[#555] dark:text-[#C0BDB5]">"{quote}"</p>
  <footer>
    <p class="font-semibold text-heading">{name}</p>
    <p class="text-secondary text-sm">{company}</p>
  </footer>
</blockquote>
