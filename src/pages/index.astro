---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import ServiceCard from "../components/ServiceCard.astro";
import ProcessStepComponent from "../components/ProcessStep.astro";
import BlogCard from "../components/BlogCard.astro";
import ContactForm from "../components/ContactForm.astro";
import { services } from "../data/services";
import { processSteps } from "../data/process";
import { siteConfig } from "../data/siteConfig";
import { getCollection } from "astro:content";
import pittImage from "../assets/images/pitt.png";
import klausImage from "../assets/images/klaus-founder.png";
import samImage from "../assets/images/sam-founder.png";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

function getReadingTime(text: string): string {
  const minutes = Math.max(1, Math.ceil(text.trim().split(/\s+/).length / 200));
  return `${minutes} min read`;
}
---

<BaseLayout
  title="Home"
  description="TechHound builds websites, AI agents, automations, and data tools for businesses. Based in Pittsburgh, working everywhere."
>

  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={pittImage}
        alt=""
        width={1920}
        height={1080}
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/70 dark:bg-void/80"></div>
    </div>

    <div class="relative container-default section-padding w-full">
      <div class="max-w-4xl">
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-heading font-bold text-white leading-tight mb-6">
          Unleash Your<br /><span class="text-gold">Business.</span>
        </h1>
        <p class="text-lg sm:text-xl text-[#ccc] dark:text-[#999] mb-10 max-w-2xl leading-relaxed">
          Websites, apps, AI agents, automations, lead generation. We build the tech that powers your business. Based in Pittsburgh, working everywhere.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#contact" class="btn-primary text-sm px-8 py-4">
            Schedule a Consultation
          </a>
          <a href="#services" class="btn-outline text-sm px-8 py-4">
            See What We Build
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-gold/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- ═══════════════════════════ SERVICES ═══════════════════════════ -->
  <section id="services" class="section-padding">
    <div class="container-default">
      <div class="text-center mb-16">
        <p class="text-xs text-gold tracking-widest mb-4 uppercase font-semibold">What We Build</p>
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-heading mb-6">Our Services</h2>
        <p class="text-secondary max-w-2xl mx-auto">
          We're your outsourced engineering team. If it involves technology, we can build it, automate it, or optimize it.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.description}
            icon={service.icon}
            items={service.items}
            headingLevel="h3"
          />
        ))}
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- ═══════════════════════════ ABOUT ═══════════════════════════ -->
  <section id="about" class="section-padding bg-[#FAFAF8] dark:bg-surface-dark">
    <div class="container-default">
      <div class="text-center mb-16">
        <p class="text-xs text-gold tracking-widest mb-4 uppercase font-semibold">Who We Are</p>
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-heading mb-6">About TechHound</h2>
        <p class="text-secondary max-w-2xl mx-auto leading-relaxed">
          We started TechHound because we saw too many businesses getting ripped off by agencies or stuck trying to figure out tech on their own.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
        <div class="rounded-sm overflow-hidden border border-[#E8E4DC] dark:border-border-dark">
          <Image
            src={klausImage}
            alt="Klaus, co-founder of TechHound"
            width={800}
            class="w-full"
            loading="lazy"
          />
        </div>
        <div>
          <h3 class="text-2xl font-heading font-bold mb-2 text-heading">Klaus</h3>
          <p class="text-xs text-gold mb-4 uppercase tracking-wider font-medium">Co-Founder &middot; Engineering</p>
          <div class="space-y-4 text-secondary leading-relaxed">
            <p>
              Klaus graduated from the University of Pittsburgh with a degree in computer engineering. He's built software for Fortune 500 companies like Lubrizol and for federal agencies including the FDIC, TVA, and DOT. Today he works as a software engineer at DraftKings.
            </p>
            <p>
              When you work with TechHound, you talk directly to the engineers building your project. No sales team, no account managers. The person on the call is the person writing the code.
            </p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div class="rounded-sm overflow-hidden border border-[#E8E4DC] dark:border-border-dark lg:order-2">
          <Image
            src={samImage}
            alt="Sam, co-founder of TechHound"
            width={800}
            class="w-full"
            loading="lazy"
          />
        </div>
        <div class="lg:order-1">
          <h3 class="text-2xl font-heading font-bold mb-2 text-heading">Sam</h3>
          <p class="text-xs text-gold mb-4 uppercase tracking-wider font-medium">Co-Founder &middot; Operations</p>
          <div class="space-y-4 text-secondary leading-relaxed">
            <p>
              Sam leads everything outside the code. Branding, marketing, creative direction, client communications, and day-to-day operations all run through her.
            </p>
            <p>
              From shaping how TechHound presents itself to the world to making sure every client has a great experience from first call to final delivery, Sam keeps the operation tight and the quality high.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- ═══════════════════════════ PROCESS ═══════════════════════════ -->
  <section id="process" class="section-padding">
    <div class="container-default">
      <div class="text-center mb-16">
        <p class="text-xs text-gold tracking-widest mb-4 uppercase font-semibold">How It Works</p>
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-heading mb-6">Our Process</h2>
        <p class="text-secondary max-w-2xl mx-auto">
          No mystery. No surprises. Here's exactly how we work.
        </p>
      </div>
      <div class="max-w-2xl mx-auto mb-12">
        {processSteps.map((step, index) => (
          <ProcessStepComponent
            number={step.number}
            title={step.title}
            description={step.description}
            isLast={index === processSteps.length - 1}
          />
        ))}
      </div>
      <div class="text-center">
        <a href="#contact" class="btn-outline px-8 py-4">
          Start a Project
        </a>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- ═══════════════════════════ BLOG ═══════════════════════════ -->
  <section id="blog" class="section-padding bg-[#FAFAF8] dark:bg-surface-dark">
    <div class="container-default">
      <div class="text-center mb-16">
        <p class="text-xs text-gold tracking-widest mb-4 uppercase font-semibold">Latest Posts</p>
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-heading mb-6">Blog</h2>
        <p class="text-secondary max-w-2xl mx-auto">
          Thoughts on software, business, and the changing tech landscape.
        </p>
      </div>

      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              slug={post.id}
              tags={post.data.tags}
              readingTime={post.body ? getReadingTime(post.body) : undefined}
            />
          ))}
        </div>
      ) : (
        <div class="text-center py-16">
          <p class="text-secondary text-lg">Posts coming soon.</p>
        </div>
      )}

      <div class="text-center mt-12">
        <a href="/blog/" class="btn-outline px-8 py-4">
          See All Posts
        </a>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- ═══════════════════════════ CONTACT ═══════════════════════════ -->
  <section id="contact" class="section-padding">
    <div class="container-default">
      <div class="text-center mb-16">
        <p class="text-xs text-gold tracking-widest mb-4 uppercase font-semibold">Get In Touch</p>
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-heading mb-6">Let's Talk</h2>
        <p class="text-secondary max-w-2xl mx-auto">
          Have a project in mind? Just want to ask a question? Reach out and we'll get back to you within 24 hours.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 max-w-6xl mx-auto">
        <div class="lg:col-span-2">
          <ContactForm />
        </div>

        <div class="space-y-8">
          <div>
            <h3 class="text-xs text-gold uppercase tracking-wider mb-3 font-semibold">Call Us</h3>
            <a
              href={`tel:${siteConfig.phone}`}
              class="text-gold hover:text-gold-bright transition-colors text-lg"
            >
              {siteConfig.phone}
            </a>
          </div>

          <div>
            <h3 class="text-xs text-gold uppercase tracking-wider mb-3 font-semibold">Email Us</h3>
            <a
              href={`mailto:${siteConfig.email}`}
              class="text-gold hover:text-gold-bright transition-colors"
            >
              {siteConfig.email}
            </a>
          </div>

          <div>
            <h3 class="text-xs text-gold uppercase tracking-wider mb-3 font-semibold">Meet With Us</h3>
            <p class="text-secondary leading-relaxed">
              Remote or in-person meetups in the Pittsburgh area.
            </p>
          </div>

          <div class="card p-6 !border-gold/20">
            <h3 class="text-xs text-gold uppercase tracking-wider mb-3 font-semibold">Free Consultation</h3>
            <p class="text-secondary text-sm leading-relaxed">
              Every conversation starts with a free, no-obligation discovery call. We'll learn about your project and let you know how we can help.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: services.map((service, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Service",
        name: service.title,
        description: service.description,
        provider: { "@id": `${siteConfig.url}/#organization` },
        areaServed: {
          "@type": "Country",
          name: "United States",
        },
      },
    })),
  })} />
</BaseLayout>
