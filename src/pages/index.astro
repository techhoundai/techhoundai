---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import ProcessStepComponent from "../components/ProcessStep.astro";
import BlogCard from "../components/BlogCard.astro";
import ContactForm from "../components/ContactForm.astro";
import { services } from "../data/services";
import { processSteps } from "../data/process";
import { siteConfig } from "../data/siteConfig";
import { getCollection } from "astro:content";
import pittImage from "../assets/images/pitt.png";
import klausImage from "../assets/images/klaus-founder.png";
import samImage from "../assets/images/sam-founder.png";
import chcImage1 from "../assets/images/completehomecomfort1.png";

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

function getReadingTime(text: string): string {
  const minutes = Math.max(1, Math.ceil(text.trim().split(/\s+/).length / 200));
  return `${minutes} min read`;
}
---

<BaseLayout
  title="Home"
  description="Websites, automations, and marketing tools for trade businesses. Plumbers, electricians, HVAC techs, landscapers, roofers, and contractors. Everything you need to grow online, starting at $100/month."
>

  <!-- ═══════════════════════════ HERO ═══════════════════════════ -->
  <section id="hero" class="relative min-h-screen flex items-center overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={pittImage}
        alt=""
        width={1920}
        height={1080}
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-black/70 dark:bg-void/80"></div>
    </div>

    <div class="relative container-default section-padding w-full">
      <div class="max-w-4xl">
        <h1 class="text-4xl sm:text-5xl md:text-7xl font-heading font-bold text-white leading-tight mb-6">
          More Jobs.<br /><span class="text-gold">Less Hassle.</span>
        </h1>
        <p class="text-lg sm:text-xl text-[#ccc] dark:text-[#999] mb-10 max-w-2xl leading-relaxed">
          We build your website, sync your job photos to Google and Yelp, auto-reply to reviews with SEO keywords, publish blog posts that rank, find you leads on social media, and text back your missed calls. All for <span class="text-gold font-semibold">$100/month</span>.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="#contact" class="btn-primary text-sm px-8 py-4">
            Get a Free Quote
          </a>
          <a href="#services" class="btn-outline text-sm px-8 py-4">
            See What We Build
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-gold/40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- ═══════════════════════════ WHAT WE DO ═══════════════════════════ -->
  <section id="services" class="section-padding">
    <div class="container-default">
      <div class="text-center mb-16">
        <p class="text-xs text-gold tracking-widest mb-4 uppercase font-semibold">What We Do</p>
        <h2 class="text-3xl sm:text-4xl font-heading font-bold text-heading mb-6">Everything Your Trade Business Needs Online</h2>
        <p class="text-secondary max-w-2xl mx-auto">
          Not another web agency selling you a template. We build real tools that get you more jobs and save you hours every week.
        </p>
      </div>

      <div class="space-y-6">
        <!-- Feature 1: Job Photo Sync -->
        <div class="card p-6 md:p-8 hover:border-gold/30 transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-6 items-start">
            <div class="w-12 h-12 rounded-sm bg-gold/10 border border-gold/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="18" height="18" rx="2" stroke-linecap="round" stroke-linejoin="round" />
                <circle cx="8.5" cy="8.5" r="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 15l-5-5L5 21" />
              </svg>
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <h3 class="text-xl font-heading font-bold text-heading">Job Photos on Autopilot</h3>
                <span class="text-[10px] px-2 py-1 rounded-sm bg-gold/10 text-gold border border-gold/20 font-medium uppercase tracking-wider">From $15/mo</span>
              </div>
              <p class="text-secondary leading-relaxed mb-4">
                Post a finished job photo to Instagram with a hashtag and it automatically appears on your website, Yelp page, and Google Business Profile. No logging into three different platforms. No uploading the same photo three times. And we're not limited to Instagram. Post to Facebook, Google, or anywhere else and we can pull photos from there too.
              </p>
              <div class="bg-[#FAFAF8] dark:bg-surface-darker border border-[#E8E4DC] dark:border-border-dark rounded-sm p-4">
                <p class="text-sm text-secondary italic">
                  <span class="text-gold font-semibold not-italic">Real example:</span> One of our HVAC clients hashtags finished job photos on Instagram. They sync to his website gallery, his Yelp business page, and his Google Business Profile automatically. Same thing with his Google reviews. His online presence stays fresh without him lifting a finger.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Feature 2: Google Review Automation -->
        <div class="card p-6 md:p-8 hover:border-gold/30 transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-6 items-start">
            <div class="w-12 h-12 rounded-sm bg-gold/10 border border-gold/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <h3 class="text-xl font-heading font-bold text-heading">Google Reviews on Autopilot</h3>
                <span class="text-[10px] px-2 py-1 rounded-sm bg-gold/10 text-gold border border-gold/20 font-medium uppercase tracking-wider">From $10/mo</span>
              </div>
              <p class="text-secondary leading-relaxed mb-4">
                Every Google review is an SEO opportunity. We auto-reply to your reviews with responses that include keywords like "best plumber in [your city]" or "trusted HVAC repair in [your area]." Your rankings go up while you focus on the next job.
              </p>
              <div class="bg-[#FAFAF8] dark:bg-surface-darker border border-[#E8E4DC] dark:border-border-dark rounded-sm p-4">
                <p class="text-sm text-secondary italic">
                  <span class="text-gold font-semibold not-italic">How it works:</span> Customer leaves a 5-star review. Within hours, your Google profile responds with a professional, keyword-rich reply that thanks them and reinforces what you do and where you do it. Google sees that activity and rewards you in local search.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Feature 3: Blog Automation -->
        <div class="card p-6 md:p-8 hover:border-gold/30 transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-6 items-start">
            <div class="w-12 h-12 rounded-sm bg-gold/10 border border-gold/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <h3 class="text-xl font-heading font-bold text-heading">Blog Posts That Rank</h3>
                <span class="text-[10px] px-2 py-1 rounded-sm bg-gold/10 text-gold border border-gold/20 font-medium uppercase tracking-wider">From $20/mo</span>
              </div>
              <p class="text-secondary leading-relaxed mb-4">
                We automatically generate and publish blog posts to your website that target the searches people in your area are making. "Water heater repair in Pittsburgh." "Best landscaper in [your town]." You build topical authority in your area for your trade without writing a single word.
              </p>
              <div class="bg-[#FAFAF8] dark:bg-surface-darker border border-[#E8E4DC] dark:border-border-dark rounded-sm p-4">
                <p class="text-sm text-secondary italic">
                  <span class="text-gold font-semibold not-italic">Why it matters:</span> Google rewards websites that consistently publish relevant content. A plumber with 50 blog posts about plumbing in their service area will outrank a competitor with just a homepage. We make that happen on autopilot.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Feature 4: Lead Gen & Backlinking -->
        <div class="card p-6 md:p-8 hover:border-gold/30 transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-6 items-start">
            <div class="w-12 h-12 rounded-sm bg-gold/10 border border-gold/20 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.07 4.93A10 10 0 004.93 19.07" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M16.24 7.76A6 6 0 007.76 16.24" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.41 10.59A2 2 0 0010.59 13.41" />
                <line x1="2" y1="2" x2="22" y2="22" stroke-linecap="round" />
              </svg>
            </div>
            <div>
              <div class="flex flex-wrap items-center gap-3 mb-3">
                <h3 class="text-xl font-heading font-bold text-heading">Lead Gen & Backlinking</h3>
                <span class="text-[10px] px-2 py-1 rounded-sm bg-gold/10 text-gold border border-gold/20 font-medium uppercase tracking-wider">From $25/mo</span>
              </div>
              <p class="text-secondary leading-relaxed mb-4">
                We scan Facebook, Nextdoor, Reddit, and Craigslist for people asking about your services. When someone posts "need a plumber ASAP" or "looking for a good electrician," we automatically recommend your business in that thread. That's a warm lead and a backlink to your site, before your competitors even see the post.
              </p>
              <div class="bg-[#FAFAF8] dark:bg-surface-darker border border-[#E8E4DC] dark:border-border-dark rounded-sm p-4">
                <p class="text-sm text-secondary italic">
                  <span class="text-gold font-semibold not-italic">Real example:</span> We built this for a plumbing client. Every morning he gets an email with links to posts from people in his area asking for plumbing help, plus draft comments recommending his business. Leads delivered to his inbox before breakfast.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Feature 5: Missed Call Texts & Automations -->
        <div class="card p-6 md:p-8 hover:border-gold/30 transition-all duration-300">
