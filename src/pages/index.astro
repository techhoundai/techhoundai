  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: services.map((service, i) => ({
      "@type": "ListItem",
      position: i + 1,
      item: {
        "@type": "Service",
        name: service.title,
        description: service.description,
        provider: { "@id": `${siteConfig.url}/#organization` },
        areaServed: {
          "@type": "Country",
          name: "United States",
        },
      },
    })),
  })} />
</BaseLayout>
