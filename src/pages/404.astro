---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found"
  description="The page you're looking for doesn't exist."
>
  <section class="section-padding min-h-[60vh] flex items-center pt-28">
    <div class="container-default text-center">
      <p class="text-6xl sm:text-8xl font-extrabold text-gold mb-6">404</p>
      <h1 class="text-2xl sm:text-3xl font-heading font-semibold mb-4 text-heading">Page Not Found</h1>
      <p class="text-secondary text-lg mb-8 max-w-md mx-auto">
        The page you're looking for doesn't exist or has been moved.
      </p>
      <a href="/" class="btn-primary">Back to Home</a>
    </div>
  </section>
</BaseLayout>
